---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceList from '../../components/ServiceList.astro';
import Cta from '../../components/Cta.astro';
import Arrow from '../../components/Arrow.astro';
import { process, keyResults } from '../../data/site';
---
<Base title="Servicii de marketing digital" description="Servicii de marketing omnichannel care vizează întreaga călătorie a clientului: audit, strategie, reclame plătite, SEO, email și SMS marketing, branding.">
  <PageHero eyebrow="Servicii" title="Marketing digital focusat pe <em>rezultate concrete.</em>" lead="Îți oferim servicii de marketing omnichannel care vizează întreaga călătorie a clientului. De la audit și strategie, până la implementare și raportare, ne ocupăm de fiecare etapă." crumbs={[{ label: 'Servicii' }]} />
  <section class="section--tight" style="padding-top:0"><div class="wrap"><ServiceList /></div></section>

  <section class="section on-dark">
    <div class="wrap">
      <div class="sec-head"><p class="eyebrow">Cum funcționează</p><h2 class="h2">Colaborarea noastră, în <em>trei etape.</em></h2></div>
      <ol class="proc">
        {process.map((p, i) => <li data-reveal style={`--d:${i * 100}ms`}><span class="proc__n">{i + 1}</span><h3 class="h3">{p.title}</h3><p class="muted">{p.text}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid">
      <div class="kr__head"><p class="eyebrow">Abordare integrată</p><h2 class="h2">Patru rezultate cheie, <em>un singur sistem.</em></h2><a class="btn" href="/audit-gratuit/"><span>Începe cu un audit gratuit</span><Arrow /></a></div>
      <ol class="steps kr__list">{keyResults.map((k) => <li><span><strong>{k.title}.</strong> {k.text}</span></li>)}</ol>
    </div>
  </section>
  <Cta title="Suntem aici să te ajutăm cu servicii de marketing <em>pentru afacerea ta.</em>" />
</Base>
<style>
  .proc { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gap); }
  .proc li { border-top: 1px solid var(--line); padding-top: 1.5rem; display: grid; gap: 1rem; align-content: start; }
  .proc__n { font-family: var(--serif); font-size: clamp(5rem, 9vw, 8rem); line-height: 0.8; color: var(--rose); margin-bottom: 1.5rem; }
  .kr__head { grid-column: 1 / span 5; display: grid; gap: 1.5rem; align-content: start; justify-items: start; }
  .kr__list { grid-column: 7 / -1; }
  .kr__list strong { font-weight: 650; }
  @media (max-width: 900px) { .proc { grid-template-columns: 1fr; } .kr__head, .kr__list { grid-column: 1 / -1; } .kr__list { margin-top: 2rem; } }
</style>
