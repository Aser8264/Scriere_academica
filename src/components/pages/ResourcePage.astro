---
import Base from '../../layouts/Base.astro';
import BrevoForm from '../BrevoForm.astro';
import Arrow from '../Arrow.astro';
import { ebooks } from '../../data/site';
import forms from '../../data/forms.json';
import type { Resource } from '../../data/resources';
interface Props { resource: Resource }
const { resource: r } = Astro.props;
const book = ebooks.find((e) => e.slug === r.slug)!;
const others = ebooks.filter((e) => e.slug !== r.slug).slice(0, 3);
---
<Base title={`${r.heading} — resursă gratuită`} description={r.lead} image={book.img}>
  <section class="res">
    <div class="wrap res__grid">
      <div class="res__main">
        <nav class="res__crumbs" aria-label="Breadcrumb"><a href="/ebook/">Resurse gratuite</a><span aria-hidden="true">/</span><span>{book.kind}</span></nav>
        <h1 class="h1">{r.heading}</h1>
        <p class="lead">{r.lead}</p>
        <a class="btn res__jump" href="#ebook"><span>{r.formTitle}</span><Arrow dir="down" /></a>
        <figure class="res__cover"><img src={book.img} alt={`Coperta: ${r.heading}`} width="900" height="1125" /></figure>
        {r.sections.map((s) => (
          <section class="res__sec">
            <h2 class="h3">{s.title}</h2>
            {s.paras?.map((p) => <p>{p}</p>)}
            {s.items && (s.numbered ? <ol class="steps">{s.items.map((i) => <li><span>{i}</span></li>)}</ol> : <ul class="ticks">{s.items.map((i) => <li>{i}</li>)}</ul>)}
            {s.cards && <dl class="res__cards">{s.cards.map((c) => <div><dt>{c.title}</dt><dd>{c.text}</dd></div>)}</dl>}
          </section>
        ))}
      </div>
      <aside class="res__form" id="ebook">
        <div class="res__box on-dark">
          <p class="eyebrow">Gratuit</p>
          <h2 class="h3">{r.formTitle}</h2>
          {r.externalForm
            ? <><p class="muted">Formularul se deschide într-o pagină securizată Brevo. După completare primești checklist-ul pe email.</p><a class="btn" href={forms.checklistUrl} target="_blank" rel="noopener"><span>Vreau checklist-ul gratuit</span><Arrow dir="up-right" /></a></>
            : <BrevoForm formKey={r.formKey!} />}
        </div>
      </aside>
    </div>
  </section>
  <section class="section--tight res__more">
    <div class="wrap">
      <p class="eyebrow">Alte resurse gratuite</p>
      <ul>{others.map((e) => <li><a href={`/${e.slug}/`}><span class="tag">{e.kind}</span><span class="h3">{e.title}</span></a></li>)}</ul>
    </div>
  </section>
</Base>
<style>
  .res { padding-block: clamp(3rem, 6vw, 5.5rem) clamp(4rem, 8vw, 7rem); }
  .res__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 3rem var(--gap); align-items: start; }
  .res__main { grid-column: 1 / span 7; display: grid; gap: 1.75rem; }
  .res__crumbs { display: flex; gap: 0.5rem; font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-soft); }
  .res__main .h1 { font-size: clamp(2.5rem, 5.4vw, 4.8rem); }
  .res__jump { display: none; justify-self: start; }
  @media (max-width: 1000px) { .res__jump { display: inline-flex; } }
  .res__cover { background: var(--white); max-width: 26rem; margin-top: 1rem; }
  .res__cover img { mix-blend-mode: multiply; width: 100%; }
  .res__sec { display: grid; gap: 1.1rem; padding-top: 2.5rem; margin-top: 1rem; border-top: 1px solid var(--line-strong); }
  .res__sec p { color: var(--ink-soft); max-width: 42rem; }
  .res__cards { margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0 var(--gap); }
  .res__cards > div { padding: 1.25rem 0; border-top: 1px solid var(--line); }
  .res__cards dt { font-weight: 650; margin-bottom: 0.4rem; }
  .res__cards dd { margin: 0; color: var(--ink-soft); font-size: 0.9875rem; }
  .res__form { grid-column: 9 / -1; position: sticky; top: calc(var(--header-h) + 1.5rem); }
  .res__box { padding: clamp(1.5rem, 2.5vw, 2.25rem); display: grid; gap: 1.25rem; }
  .res__more { border-top: 1px solid var(--line); }
  .res__more ul { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gap); margin-top: 2rem; }
  .res__more a { display: grid; gap: 0.75rem; border-top: 1px solid var(--line-strong); padding-top: 1.25rem; transition: color 0.3s; }
  .res__more a:hover { color: var(--plum); }
  @media (max-width: 1000px) {
    .res__main, .res__form { grid-column: 1 / -1; position: static; }
    .res__cards, .res__more ul { grid-template-columns: 1fr; }
  }
</style>
