---
import Base from '../../layouts/Base.astro';
import PageHero from '../PageHero.astro';
interface Props { title: string; description?: string; html: string }
const { title, description, html } = Astro.props;
---
<Base title={title} description={description}>
  <PageHero eyebrow="Informații legale" title={title} crumbs={[{ label: title }]} />
  <section class="wrap legal"><div class="prose" set:html={html} /></section>
</Base>
<style>
  .legal { padding-bottom: var(--section); display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); border-top: 1px solid var(--line); padding-top: 3rem; }
  .legal .prose { grid-column: 4 / span 8; font-size: 1.0625rem; }
  @media (max-width: 900px) { .legal .prose { grid-column: 1 / -1; } }
</style>
