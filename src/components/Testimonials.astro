---
import { testimonials } from '../data/site';
interface Props { title?: string }
const { title = 'Ce spun <em>clienții noștri</em>' } = Astro.props;
---
<section class="section tst" aria-labelledby="tst-h">
  <div class="wrap">
    <div class="tst__head">
      <p class="eyebrow">Testimoniale</p>
      <h2 class="h2" id="tst-h" set:html={title} />
    </div>
    <div class="tst__body" data-tst>
      <div class="tst__tabs" role="tablist" aria-label="Clienți">
        {testimonials.map((t, i) => (
          <button role="tab" type="button" id={`tst-tab-${i}`} aria-controls={`tst-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
            <span class="num">{String(i + 1).padStart(2, '0')}</span><span>{t.short}</span>
          </button>
        ))}
      </div>
      <div class="tst__panels">
        {testimonials.map((t, i) => (
          <figure role="tabpanel" id={`tst-panel-${i}`} aria-labelledby={`tst-tab-${i}`} hidden={i !== 0} tabindex="0">
            <blockquote>
              <p class="tst__first">{t.quote[0]}</p>
              {t.quote.slice(1).map((q) => <p class="tst__rest">{q}</p>)}
            </blockquote>
            <figcaption><strong>{t.name}</strong><span>{t.role}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </div>
</section>
<style>
  .tst__head { display: grid; gap: 1.25rem; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .tst__body { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 2.5rem var(--gap); align-items: start; }
  .tst__tabs { grid-column: 1 / span 3; display: grid; border-top: 1px solid var(--line); position: sticky; top: calc(var(--header-h) + 2rem); }
  .tst__tabs button { display: flex; align-items: baseline; gap: 1rem; padding: 1rem 0; background: none; border: 0; border-bottom: 1px solid var(--line); text-align: left; cursor: pointer; font-size: 1.0625rem; font-weight: 500; color: var(--ink-soft); transition: color 0.25s, padding-left 0.35s var(--ease); }
  .tst__tabs button:hover { color: var(--ink); }
  .tst__tabs button[aria-selected='true'] { color: var(--ink); padding-left: 0.75rem; font-weight: 650; }
  .tst__panels { grid-column: 5 / -1; }
  .tst__first { font-family: var(--serif); font-size: clamp(1.6rem, 2.9vw, 2.7rem); line-height: 1.16; letter-spacing: -0.012em; text-wrap: pretty; }
  .tst__first::before { content: '„'; color: var(--plum); }
  .tst__rest { margin-top: 1.25rem; max-width: 46rem; color: var(--ink-soft); font-size: 1.0625rem; }
  figcaption { display: flex; flex-wrap: wrap; gap: 0.3rem 1rem; align-items: baseline; margin-top: 2.25rem; padding-top: 1.25rem; border-top: 1px solid var(--line-strong); max-width: 46rem; }
  figcaption span { color: var(--ink-soft); }
  figure:not([hidden]) { animation: tst-in 0.6s var(--ease); }
  @keyframes tst-in { from { opacity: 0; transform: translateY(0.75rem); } }
  @media (max-width: 900px) {
    .tst__tabs { grid-column: 1 / -1; position: static; display: flex; overflow-x: auto; border-top: 0; gap: 0.5rem; padding-bottom: 0.5rem; scrollbar-width: none; margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter); }
    .tst__tabs button { flex: none; border: 1px solid var(--line); border-radius: 999px; padding: 0.55rem 1rem !important; font-size: 0.9375rem; }
    .tst__tabs button .num { display: none; }
    .tst__tabs button[aria-selected='true'] { background: var(--ink); color: var(--white); border-color: var(--ink); }
    .tst__panels { grid-column: 1 / -1; }
  }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-tst]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role=tabpanel]')];
    const select = (i: number, focus = false) => {
      tabs.forEach((t, j) => { t.setAttribute('aria-selected', String(i === j)); t.tabIndex = i === j ? 0 : -1; });
      panels.forEach((p, j) => (p.hidden = i !== j));
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        if (['ArrowDown', 'ArrowRight'].includes(e.key)) { e.preventDefault(); select((i + 1) % tabs.length, true); }
        if (['ArrowUp', 'ArrowLeft'].includes(e.key)) { e.preventDefault(); select((i - 1 + tabs.length) % tabs.length, true); }
      });
    });
  });
</script>
