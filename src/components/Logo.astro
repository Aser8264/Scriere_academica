---
import Mark from './Mark.astro';
interface Props { size?: number }
const { size = 34 } = Astro.props;
---
<span class="logo">
  <Mark size={size} class="logo__mark" />
  <span class="logo__word">dar<span>media</span></span>
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 0.6rem; }
  .logo :global(.logo__mark) { color: var(--plum); transition: transform 0.6s var(--ease); }
  :global(.on-dark) .logo :global(.logo__mark), :global(.on-plum) .logo :global(.logo__mark) { color: var(--white); }
  .logo:hover :global(.logo__mark) { transform: rotate(-8deg); }
  .logo__word { font-family: var(--sans); font-weight: 700; font-size: 1.35rem; letter-spacing: -0.04em; line-height: 1; }
  .logo__word span { font-weight: 400; margin-left: 0.18em; }
</style>
