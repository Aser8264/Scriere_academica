---
import type { Faq } from '../data/site';
interface Props { items: Faq[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((f) => (
    <details>
      <summary><span>{f.q}</span><i aria-hidden="true"></i></summary>
      <div class="faq__a" set:html={f.a} />
    </details>
  ))}
</div>
<style>
  .faq { border-top: 1px solid var(--line-strong); }
  details { border-bottom: 1px solid var(--line); }
  summary { display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; padding: 1.35rem 0; cursor: pointer; list-style: none; font-family: var(--serif); font-size: clamp(1.3rem, 1.9vw, 1.65rem); line-height: 1.2; transition: color 0.25s; }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--plum); }
  summary i { position: relative; flex: none; width: 1rem; height: 1rem; }
  summary i::before, summary i::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1.5px; background: currentColor; transition: transform 0.35s var(--ease); }
  summary i::after { transform: rotate(90deg); }
  details[open] summary i::after { transform: rotate(0); }
  .faq__a { padding: 0 3rem 1.75rem 0; max-width: 44rem; color: var(--ink-soft); }
  .faq__a :global(p + p), .faq__a :global(p + ul), .faq__a :global(ul + p), .faq__a :global(p + ol) { margin-top: 0.85rem; }
  .faq__a :global(ul), .faq__a :global(ol) { padding-left: 1.2rem; }
  .faq__a :global(ul) { list-style: disc; }
  .faq__a :global(ol) { list-style: decimal; }
  .faq__a :global(li) { margin-top: 0.3rem; }
  .faq__a :global(li::marker) { color: var(--plum); }
  .faq__a :global(strong) { color: var(--ink); font-weight: 650; }
  .faq__a :global(a) { color: var(--plum); text-decoration: underline; text-underline-offset: 0.2em; }
</style>
