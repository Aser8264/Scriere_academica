---
import Arrow from './Arrow.astro';
import { services, groups } from '../data/services';
let n = 0;
---
<div class="svc">
  {groups.map((g) => (
    <div class="svc__group">
      <div class="svc__label"><p class="eyebrow">{g.label}</p><p class="muted small">{g.note}</p></div>
      <ul class="svc__rows">
        {services.filter((s) => s.group === g.id && !s.parent).map((s) => {
          n += 1;
          const subs = services.filter((x) => x.parent === s.slug);
          return (
            <li>
              <a class="svc__row" href={`/${s.slug}/`}>
                <span class="num">{String(n).padStart(2, '0')}</span>
                <span class="svc__name">{s.name}</span>
                <span class="svc__sum">{s.summary}</span>
                <Arrow />
              </a>
              {subs.length > 0 && (
                <ul class="svc__subs">{subs.map((x) => <li><a href={`/${x.slug}/`}>{x.name}</a></li>)}</ul>
              )}
            </li>
          );
        })}
      </ul>
    </div>
  ))}
</div>
<style>
  .svc__group { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); border-top: 1px solid var(--line-strong); padding-top: 1.5rem; }
  .svc__group + .svc__group { margin-top: clamp(2.5rem, 5vw, 4rem); }
  .svc__label { grid-column: 1 / span 3; display: grid; gap: 0.5rem; align-content: start; position: sticky; top: calc(var(--header-h) + 1.5rem); align-self: start; padding-bottom: 1.5rem; }
  .svc__rows { grid-column: 4 / -1; }
  .svc__rows > li { border-bottom: 1px solid var(--line); }
  .svc__rows > li:first-child .svc__row { padding-top: 0; }
  .svc__row { display: grid; grid-template-columns: 3rem minmax(0, 1.1fr) minmax(0, 1fr) 1.5rem; gap: 1rem 1.5rem; align-items: baseline; padding: 1.5rem 0; transition: padding 0.45s var(--ease), color 0.3s; }
  .svc__name { font-family: var(--serif); font-size: clamp(1.8rem, 3.4vw, 3.1rem); line-height: 1.02; letter-spacing: -0.02em; }
  .svc__sum { color: var(--ink-soft); font-size: 0.9875rem; line-height: 1.45; }
  .svc__row :global(.arrow) { align-self: center; opacity: 0; transform: translateX(-0.75rem); transition: opacity 0.3s, transform 0.45s var(--ease); color: var(--plum); }
  .svc__row:hover { padding-left: 1rem; color: var(--plum); }
  .svc__row:hover :global(.arrow) { opacity: 1; transform: none; }
  .svc__subs { display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 0 0 1.5rem 4.5rem; }
  .svc__subs a { display: inline-flex; padding: 0.4rem 0.95rem; border: 1px solid var(--line); border-radius: 999px; font-size: 0.875rem; font-weight: 500; transition: background 0.25s, color 0.25s, border-color 0.25s; }
  .svc__subs a:hover { background: var(--plum); border-color: var(--plum); color: var(--white); }
  @media (max-width: 900px) {
    .svc__label { grid-column: 1 / -1; position: static; }
    .svc__rows { grid-column: 1 / -1; }
    .svc__row { grid-template-columns: 2.25rem 1fr 1.25rem; }
    .svc__sum { grid-column: 2 / 3; grid-row: 2; }
    .svc__row :global(.arrow) { opacity: 1; transform: none; grid-row: 1; grid-column: 3; }
    .svc__row:hover { padding-left: 0; }
    .svc__subs { padding-left: 3.25rem; }
  }
</style>
