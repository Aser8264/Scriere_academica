---
import Logo from './Logo.astro';
import Arrow from './Arrow.astro';
import { nav, aboutNav, company } from '../data/site';
import { services, groups } from '../data/services';
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---
<header class="hdr" data-header>
  <div class="wrap hdr__in">
    <a href="/" class="hdr__logo" aria-label="DAR Media — acasă"><Logo /></a>
    <nav class="hdr__nav" aria-label="Navigație principală">
      <ul>
        {nav.map((n) => (
          <li>
            {n.href === '/servicii/' ? (
              <button type="button" class:list={['hdr__link', { 'is-active': isActive(n.href) }]} aria-expanded="false" aria-controls="mega" data-mega-toggle>
                {n.label}<svg viewBox="0 0 10 6" width="9" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
              </button>
            ) : (
              <a href={n.href} class:list={['hdr__link', { 'is-active': isActive(n.href) }]} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <div class="hdr__end">
      <a href={company.english} class="hdr__lang" hreflang="en" lang="en" aria-label="English version">EN</a>
      <a href="/contact/" class="hdr__cta">Contact</a>
      <button type="button" class="hdr__burger" aria-expanded="false" aria-controls="menu" data-menu-toggle>
        <span class="sr-only">Meniu</span><i></i><i></i>
      </button>
    </div>
  </div>

  <div class="mega" id="mega" hidden data-mega>
    <div class="wrap mega__in">
      <div class="mega__intro">
        <p class="h3">Servicii de marketing digital, focusate pe <em>rezultate concrete.</em></p>
        <a href="/servicii/" class="more">Toate serviciile <Arrow /></a>
      </div>
      {groups.map((g) => (
        <div class="mega__col">
          <p class="eyebrow">{g.label}</p>
          <ul>
            {services.filter((s) => s.group === g.id).map((s) => (
              <li class:list={{ sub: !!s.parent }}><a href={`/${s.slug}/`}>{s.name}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</header>

<div class="menu on-dark" id="menu" hidden data-menu>
  <div class="wrap menu__in">
    <nav aria-label="Meniu mobil">
      <ul class="menu__main">
        <li><a href="/">Acasă</a></li>
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        <li><a href="/contact/">Contact</a></li>
      </ul>
      <ul class="menu__sub">
        {aboutNav.slice(1).map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        <li><a href="/audit-gratuit/">Audit gratuit</a></li>
        <li><a href={company.english} hreflang="en" lang="en">English</a></li>
      </ul>
    </nav>
    <div class="menu__foot">
      <a href={`mailto:${company.email}`}>{company.email}</a>
      <a href={company.phoneHref}>{company.phone}</a>
    </div>
  </div>
</div>

<style>
  .hdr { position: sticky; top: 0; z-index: 50; background: var(--paper); transition: box-shadow 0.3s, transform 0.4s var(--ease); }
  .hdr.is-scrolled { box-shadow: 0 1px 0 var(--line); }
  .hdr__in { display: flex; align-items: center; justify-content: space-between; height: var(--header-h); gap: 2rem; }
  .hdr__logo { flex: none; }
  .hdr__nav ul { display: flex; gap: clamp(1.1rem, 2.1vw, 2.25rem); }
  .hdr__link { position: relative; display: inline-flex; align-items: center; gap: 0.4rem; background: none; border: 0; padding: 0.5rem 0; cursor: pointer; font-size: 0.9375rem; font-weight: 500; }
  .hdr__link::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0.15rem; height: 1px; background: currentColor; transform: scaleX(0); transform-origin: right; transition: transform 0.35s var(--ease); }
  .hdr__link:hover::after, .hdr__link.is-active::after, .hdr__link[aria-expanded='true']::after { transform: scaleX(1); transform-origin: left; }
  .hdr__link.is-active { color: var(--plum); }
  .hdr__link svg { transition: transform 0.3s var(--ease); }
  .hdr__link[aria-expanded='true'] svg { transform: rotate(180deg); }
  .hdr__end { display: flex; align-items: center; gap: 1.25rem; }
  .hdr__lang { font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.08em; color: var(--ink-soft); }
  .hdr__lang:hover { color: var(--plum); }
  .hdr__cta { display: inline-flex; align-items: center; height: 2.6rem; padding: 0 1.25rem; border: 1px solid var(--line-strong); border-radius: 999px; font-size: 0.9375rem; font-weight: 600; transition: background 0.3s var(--ease), color 0.3s var(--ease), border-color 0.3s; }
  .hdr__cta:hover { background: var(--plum); border-color: var(--plum); color: var(--white); }
  .hdr__burger { display: none; width: 2.75rem; height: 2.75rem; background: none; border: 0; padding: 0; cursor: pointer; position: relative; }
  .hdr__burger i { position: absolute; left: 0.55rem; right: 0.55rem; height: 1.5px; background: currentColor; transition: transform 0.35s var(--ease), top 0.35s var(--ease); }
  .hdr__burger i:nth-of-type(1) { top: 1.1rem; }
  .hdr__burger i:nth-of-type(2) { top: 1.6rem; }
  .hdr__burger[aria-expanded='true'] i:nth-of-type(1) { top: 1.35rem; transform: rotate(45deg); }
  .hdr__burger[aria-expanded='true'] i:nth-of-type(2) { top: 1.35rem; transform: rotate(-45deg); }

  .mega { position: absolute; left: 0; right: 0; top: 100%; background: var(--paper); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); box-shadow: 0 30px 60px -30px rgba(28, 18, 25, 0.25); }
  .mega__in { display: grid; grid-template-columns: 1.5fr repeat(4, 1fr); gap: var(--gap); padding-block: 2.75rem 3rem; }
  .mega__intro { display: flex; flex-direction: column; justify-content: space-between; gap: 2rem; padding-right: 2rem; max-width: 24rem; }
  .mega__col .eyebrow { margin-bottom: 1.1rem; }
  .mega__col li a { display: block; padding: 0.32rem 0; font-size: 1rem; transition: color 0.2s, padding-left 0.3s var(--ease); }
  .mega__col li.sub a { padding-left: 1rem; color: var(--ink-soft); font-size: 0.9375rem; }
  .mega__col li a:hover { color: var(--plum); padding-left: 0.4rem; }
  .mega__col li.sub a:hover { padding-left: 1.4rem; }

  .menu { position: fixed; inset: 0; z-index: 40; padding-top: var(--header-h); overflow-y: auto; }
  .menu__in { display: flex; flex-direction: column; justify-content: space-between; min-height: 100%; padding-block: 2rem 2.5rem; gap: 2.5rem; }
  .menu__main a { display: block; font-family: var(--serif); font-size: clamp(2.4rem, 10vw, 3.4rem); line-height: 1.12; letter-spacing: -0.02em; padding: 0.15rem 0; }
  .menu__main a:hover { color: var(--rose); }
  .menu__sub { display: flex; flex-wrap: wrap; gap: 0.6rem 1.5rem; margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--line); font-size: 1rem; color: var(--ink-soft); }
  .menu__foot { display: grid; gap: 0.3rem; font-size: 1.1rem; }

  @media (max-width: 1040px) {
    .hdr__nav, .hdr__lang, .mega { display: none !important; }
    .hdr__burger { display: block; }
    .hdr__end { gap: 0.6rem; }
  }
  @media (min-width: 1041px) { .menu { display: none !important; } }
  :global(body.menu-open) { overflow: hidden; }
  :global(body.menu-open) .hdr { background: var(--aubergine); color: var(--white); box-shadow: none; }
  :global(body.menu-open) .hdr :global(.logo__mark) { color: var(--white); }
  :global(body.menu-open) .hdr__cta { border-color: rgba(255, 252, 248, 0.5); }
</style>
